{
  "name": "@swiftscale/swiftcoder-desktop",
  "private": true,
  "version": "0.2.5",
  "description": "SwiftScale-powered AI coding agent for macOS",
  "type": "module",
  "license": "MIT",
  "homepage": "https://swiftcoder.io",
  "author": {
    "name": "SwiftScale",
    "email": "support@swift-scale.com"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "predev": "bun ./scripts/predev.ts",
    "dev": "electron-vite dev",
    "prebuild": "bun ./scripts/prebuild.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder --config electron-builder.config.ts",
    "package:mac": "electron-builder --mac --config electron-builder.config.ts",
    "package:mac:dir": "electron-builder --mac dir --config electron-builder.config.ts",
    "native:build": "bun install --cwd native"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@lydell/node-pty": "catalog:",
    "@zip.js/zip.js": "2.7.62",
    "effect": "catalog:",
    "electron-context-menu": "4.1.2",
    "electron-log": "^5",
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9",
    "electron-window-state": "^5.0.3",
    "drizzle-orm": "catalog:",
    "esprima": "4.0.1",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@swiftscale/desktop-kit": "file:../../../swiftcore/packages/desktop-kit",
    "@swiftscale/coder-app": "workspace:*",
    "@swiftscale/ui": "file:../../../swiftcore/packages/ui",
    "@sentry/solid": "catalog:",
    "@sentry/vite-plugin": "catalog:",
    "@solid-primitives/i18n": "2.2.1",
    "@solid-primitives/storage": "catalog:",
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "0.15.4",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@valibot/to-json-schema": "1.6.0",
    "electron": "42.8.1",
    "electron-builder": "26.15.3",
    "electron-vite": "^5",
    "solid-js": "catalog:",
    "sury": "11.0.0-alpha.4",
    "typescript": "catalog:",
    "vite": "catalog:",
    "zod-openapi": "5.4.6"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.15",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.15",
    "@parcel/watcher-darwin-arm64": "2.5.1",
    "@parcel/watcher-darwin-x64": "2.5.1"
  }
}
